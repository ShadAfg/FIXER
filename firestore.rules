rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'akhtarshadman044@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for contact inquiries
    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'status', 'createdAt']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 150 &&
        data.message is string && data.message.size() >= 10 && data.message.size() <= 3000 &&
        data.status is string && data.status in ['pending', 'in-review', 'resolved'] &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /inquiries/{inquiryId} {
      // Allow public creation of contact inquiries with strict validation
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming()) && (
        !isSignedIn() || incoming().userId == request.auth.uid
      );

      // Allow users to read their own inquiries, or admin to read all
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      // Only admin can update inquiry status
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // User profile records
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow delete: if isAdmin();
    }
  }
}
