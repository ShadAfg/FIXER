rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'akhtarshadman044@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidProvider(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'city', 'phone', 'createdAt']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.category is string && data.category.size() <= 60 &&
        data.city is string && data.city.size() <= 60 &&
        data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 30;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['id', 'providerId', 'customerName', 'customerPhone', 'jobDetails', 'status', 'createdAt']) &&
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
        data.customerPhone is string && data.customerPhone.size() >= 7 && data.customerPhone.size() <= 30 &&
        data.jobDetails is string && data.jobDetails.size() >= 5 && data.jobDetails.size() <= 2000 &&
        data.status is string && data.status in ['requested', 'accepted', 'declined', 'completed'];
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'status', 'createdAt']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 150 &&
        data.message is string && data.message.size() >= 10 && data.message.size() <= 3000 &&
        data.status is string && data.status in ['pending', 'in-review', 'resolved'] &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Public marketplace providers directory
    match /providers/{providerId} {
      allow read: if true;
      allow create: if isValidId(providerId) && isValidProvider(incoming());
      allow update: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if isValidId(bookingId) && isValidBooking(incoming());
      allow update: if isAdmin() || (isSignedIn() && (existing().customerEmail == request.auth.token.email || existing().providerId == request.auth.uid));
      allow delete: if isAdmin();
    }

    // Inquiries collection
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming()) && (
        !isSignedIn() || incoming().userId == request.auth.uid
      );
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow delete: if isAdmin();
    }
  }
}
